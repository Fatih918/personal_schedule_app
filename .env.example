# PostgreSQL connection string. Keep real credentials in .env, never commit them.
DATABASE_URL="postgresql://postgres:password@localhost:5432/personal_schedule?schema=public"

# Auth.js secret. Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
# Production rate limiting is fail-closed unless both Upstash values are set.
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-rest-token"

# Secret for the trusted scheduled Daily Plan reconciliation endpoint.
CRON_SECRET="replace-with-a-separate-random-secret-at-least-32-characters-long"
